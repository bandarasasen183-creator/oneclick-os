    <div id="nv-rawhtml-b375d81736" class="general-container-text            ">
    	
		

    <div> <script>
    (function () {
      'use strict';
    
      var NVIDIA_HOST = 'www.nvidia.com';
      var NVIDIA_AUTHOR_HOST = 'author.nvidia.com';
      var NVIDIA_PREVIEW_HOST = 'preview.nvidia.com';
      var AEM_CONTENT_PREFIX = '/content/nvidiaGDC/zz/en_ZZ';
      var PREVIEW_PUBLIC_PREFIX = '/en-zz';
      var LIVE_PUBLIC_PREFIX = '/en-us';
      var LOCALE_PATTERN = /^[a-z]{2}-[a-z]{2}$/i;
      var US_LOCALE = 'en-us';
      var SCOPE_SELECTOR = '.responsivegrid.aem-GridColumn';
    
      function normalizeForUrl(href) {
        if (!href) {
          return '';
        }
    
        var trimmedHref = href.trim();
    
        if (trimmedHref.indexOf('//') === 0) {
          return window.location.protocol + trimmedHref;
        }
    
        if (/^www\.nvidia\.com(?=\/|$|\?|#)/i.test(trimmedHref)) {
          return 'https://' + trimmedHref;
        }
    
        return trimmedHref;
      }
    
      function isLocaleSegment(segment) {
        return LOCALE_PATTERN.test(segment || '');
      }
    
      function getCurrentLocale() {
        var firstSegment = (window.location.pathname || '').split('/')[1] || '';
    
        return isLocaleSegment(firstSegment) ? firstSegment.toLowerCase() : '';
      }
    
      function getCurrentContentPrefix() {
        var pathname = window.location.pathname || '';
        var parts = pathname.split('/');
    
        if (parts[1] === 'content' && parts[2] === 'nvidiaGDC' && parts[3] && parts[4]) {
          return '/content/nvidiaGDC/' + parts[3] + '/' + parts[4];
        }
    
        var currentLocale = getCurrentLocale();
    
        if (!currentLocale) {
          return '';
        }
    
        var localeParts = currentLocale.split('-');
        var language = localeParts[0];
        var region = localeParts[1];
    
        return '/content/nvidiaGDC/' + region + '/' + language + '_' + region.toUpperCase();
      }
    
      function getCurrentPublicPrefix() {
        var currentHostname = window.location.hostname.toLowerCase();
        var isPublicHost = currentHostname === NVIDIA_HOST || currentHostname === NVIDIA_PREVIEW_HOST;
    
        if (!isPublicHost) {
          return '';
        }
    
        var currentLocale = getCurrentLocale();
    
        if (currentLocale) {
          return '/' + currentLocale;
        }
    
        return currentHostname === NVIDIA_PREVIEW_HOST ? PREVIEW_PUBLIC_PREFIX : LIVE_PUBLIC_PREFIX;
      }
    
      function getCurrentTargetPrefix() {
        var currentHostname = window.location.hostname.toLowerCase();
    
        if (currentHostname === NVIDIA_AUTHOR_HOST) {
          var contentPrefix = getCurrentContentPrefix();
    
          return contentPrefix ? 'https://' + NVIDIA_AUTHOR_HOST + contentPrefix : '';
        }
    
        if (currentHostname === NVIDIA_PREVIEW_HOST || currentHostname === NVIDIA_HOST) {
          var publicPrefix = getCurrentPublicPrefix();
    
          if (!publicPrefix) {
            return '';
          }
    
          return 'https://' + currentHostname + publicPrefix;
        }
    
        return '';
      }
    
      function stripLeadingLocale(pathname) {
        var parts = (pathname || '/').split('/');
    
        if (parts.length > 1 && isLocaleSegment(parts[1])) {
          parts.splice(1, 1);
          var rest = parts.join('/');
    
          return rest === '' ? '/' : rest;
        }
    
        return null;
      }
    
      function joinPath(prefix, rest) {
        return rest === '/' ? prefix : prefix + rest;
      }
    
      function rewritePathPrefix(href, oldPrefix, newPrefix) {
        var normalizedHref = normalizeForUrl(href);
    
        try {
          var url = new URL(normalizedHref, window.location.origin);
    
          if (url.pathname.indexOf(oldPrefix) === 0) {
            return newPrefix + url.pathname.slice(oldPrefix.length) + url.search + url.hash;
          }
        } catch (error) {
          if (href.indexOf(oldPrefix) === 0) {
            return newPrefix + href.slice(oldPrefix.length);
          }
        }
    
        return href;
      }
    
      function rewriteNvidiaHref(href) {
        var normalizedHref = normalizeForUrl(href);
    
        if (!/^https?:\/\//i.test(normalizedHref)) {
          return href;
        }
    
        var parsedUrl = null;
    
        try {
          parsedUrl = new URL(normalizedHref, window.location.origin);
        } catch (error) {
          return href;
        }
    
        if (parsedUrl.hostname.toLowerCase() !== NVIDIA_HOST) {
          return href;
        }
    
        var usPrefix = '/' + US_LOCALE;
        var isUsPath = parsedUrl.pathname === usPrefix || parsedUrl.pathname.indexOf(usPrefix + '/') === 0;
    
        if (!isUsPath) {
          return href;
        }
    
        var targetPrefix = getCurrentTargetPrefix();
    
        if (!targetPrefix) {
          return href;
        }
    
        return targetPrefix + parsedUrl.pathname.slice(usPrefix.length) + parsedUrl.search + parsedUrl.hash;
      }
    
      function getHostname(href) {
        var normalizedHref = normalizeForUrl(href);
    
        try {
          return new URL(normalizedHref, window.location.origin).hostname.toLowerCase();
        } catch (error) {
          return '';
        }
      }
    
      function isThirdPartyLink(anchor) {
        var href = anchor.getAttribute('href');
        var hostname = getHostname(href);
    
        return Boolean(hostname && hostname !== window.location.hostname.toLowerCase() && hostname !== NVIDIA_HOST);
      }
    
      function updateLink(anchor) {
        var originalHref = anchor.getAttribute('href');
    
        if (!originalHref || /^(#|mailto:|tel:|javascript:)/i.test(originalHref.trim())) {
          return;
        }
    
        var rewrittenHref = rewriteNvidiaHref(originalHref);
        if (rewrittenHref !== originalHref) {
          anchor.setAttribute('href', rewrittenHref);
        }
    
        if (isThirdPartyLink(anchor)) {
          anchor.setAttribute('target', '_blank');
          anchor.setAttribute('rel', 'noopener noreferrer');
        } else {
          anchor.setAttribute('target', '_self');
          anchor.removeAttribute('rel');
        }
      }
    
      function updateLinks(root) {
        var scope = root || document;
    
        if (scope.nodeType === 1 && scope.matches && scope.matches('a[href]')) {
          updateLink(scope);
        }
    
        if (!scope.querySelectorAll) {
          return;
        }
    
        var links = scope.querySelectorAll('a[href]');

        Array.prototype.forEach.call(links, updateLink);
      }

      function getScopedRoots(root) {
        var scope = root || document;
        var roots = [];

        if (scope.nodeType === 1 && scope.matches && scope.matches(SCOPE_SELECTOR)) {
          roots.push(scope);
        }

        if (scope.querySelectorAll) {
          Array.prototype.forEach.call(scope.querySelectorAll(SCOPE_SELECTOR), function (element) {
            roots.push(element);
          });
        }

        return roots;
      }

      function updateScopedLinks(root) {
        Array.prototype.forEach.call(getScopedRoots(root), updateLinks);
      }

      function updateNodeIfScoped(node) {
        if (node.nodeType !== 1) {
          return;
        }

        if (node.closest && node.closest(SCOPE_SELECTOR)) {
          updateLinks(node);
          return;
        }

        updateScopedLinks(node);
      }

      var isUpdating = false;
    
      function handleMutations(mutations) {
        if (isUpdating) {
          return;
        }
    
        isUpdating = true;
    
        try {
          for (var i = 0; i < mutations.length; i++) {
            var mutation = mutations[i];
    
            if (mutation.type === 'attributes') {
              updateNodeIfScoped(mutation.target);
            } else if (mutation.type === 'childList') {
              Array.prototype.forEach.call(mutation.addedNodes, updateNodeIfScoped);
            }
          }
        } finally {
          isUpdating = false;
        }
      }
    
      function startObserver() {
        if (!window.MutationObserver) {
          return;
        }
    
        var target = document.documentElement || document.body;
    
        if (!target) {
          return;
        }
    
        var observer = new MutationObserver(handleMutations);
    
        observer.observe(target, {
          childList: true,
          subtree: true,
          attributes: true,
          attributeFilter: ['href']
        });
      }
    
      function init() {
        updateScopedLinks(document);
        startObserver();
      }
    
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
    }());
    
    </script></div>	

