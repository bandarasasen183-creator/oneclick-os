<div class="account-picker-host">
    <section id="unauth-account-picker" class="account-picker" hidden
             aria-labelledby="account-picker-title"
             data-bi-dnt="true" data-clarity-mask="true"
             data-work-label="Work or school account"
             data-personal-label="Personal account">
        <div class="account-picker-brand">
            <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" focusable="false">
                <path fill="#f25022" d="M0 0h8.5v8.5H0z" />
                <path fill="#7fba00" d="M9.5 0H18v8.5H9.5z" />
                <path fill="#00a4ef" d="M0 9.5h8.5V18H0z" />
                <path fill="#ffb900" d="M9.5 9.5H18V18H9.5z" />
            </svg>
            <span>Microsoft</span>
            <button class="account-picker-close" type="button"
                    aria-label="Close account picker">
                <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                    <path d="m4 4 8 8M12 4l-8 8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                </svg>
            </button>
        </div>
        <div class="account-picker-intro">
            <h2 id="account-picker-title">Welcome to Copilot</h2>
            <p>Sign in to start chatting with Copilot and access your personalized experience.</p>
        </div>
        <div class="account-picker-accounts"></div>
        <button class="account-picker-different" type="button">
            <span class="account-picker-avatar" aria-hidden="true">
                <svg width="24" height="24" viewBox="0 0 24 24" focusable="false">
                    <path d="M15 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0ZM14 14H7a4 4 0 0 0-4 4v2h9"
                          fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                    <circle cx="18" cy="18" r="5" fill="currentColor" />
                    <path class="account-picker-add-mark" d="M18 15.5v5M15.5 18h5" stroke="white" stroke-width="1.3" stroke-linecap="round" />
                </svg>
            </span>
            <span>Sign in with a different account</span>
        </button>
        <template class="account-picker-row-template">
            <button class="account-picker-account" type="button">
                <span class="account-picker-avatar" aria-hidden="true">
                    <svg class="account-picker-work-icon" width="22" height="22" viewBox="0 0 24 24" focusable="false">
                        <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M5 7h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2ZM3 12a22 22 0 0 0 18 0M10 13v2h4v-2"
                              fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
                    </svg>
                    <span class="account-picker-initials" hidden></span>
                </span>
                <span class="account-picker-identity">
                    <bdi class="account-picker-name"></bdi>
                    <bdi class="account-picker-email"></bdi>
                </span>
                <svg class="account-picker-chevron" width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                    <path d="m7.5 4 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </button>
        </template>
    </section>
    <span class="account-picker-announcement" role="status" aria-live="polite"
