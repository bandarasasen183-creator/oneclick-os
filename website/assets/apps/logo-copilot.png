        /^https:\/\/m365\.cloud\.microsoft\/chat\/.*[?&]titleId=[^&]+.*$/,
        /^https:\/\/m365\.cloud\.microsoft\/apps\/.*[?&]titleId=[^&]+.*$/,
        /^https:\/\/m365\.cloud\.microsoft\/apps\/.*[?&]appId=[^&]+.*$/,
        /^https:\/\/m365\.cloud\.microsoft\/apps\/.*[?&]templatedAppId=[^&]+.*$/,
        /^https:\/\/m365\.cloud\.microsoft\/chat\/entity1-d870f6cd-4aa5-4d42-9626-ab690c041429\/.*$/,
        /^https:\/\/m365\.cloud\.microsoft\/create(?:\/.*)?(?:\?.*)?$/,
        /^https:\/\/m365\.cloud\.microsoft\/cowork(?:\/.*)?(?:\?.*)?$/,
        /^https:\/\/m365\.cloud\.microsoft\/chat\/try-voice-chat(?:\/.*)?(?:\?.*)?$/,
        // /chat or /chat/<subpath> with a fromcode QSP — DDLS deep-link/fingerprint target.
        // The path anchor (chat(?:\/[^?]*)?\?) blocks /chatfoo?...; (?:[^&]*&)* blocks
        // ?xfromcode=... and ?safe=fromcode=... by forcing fromcode= to start a fresh QSP segment.
        /^https:\/\/m365\.cloud\.microsoft\/chat(?:\/[^?]*)?\?(?:[^&]*&)*fromcode=[^&]+(?:&.*)?$/,
        // Root landing (m365.cloud.microsoft/?...fromcode=...) — DDLS deep-link/fingerprint target.
        // Same QSP guard as the /chat fromcode pattern: (?:[^&]*&)* forces fromcode= to start a fresh
        // segment, blocking /?xfromcode=... and /?safe=fromcode=...; \/\? anchors the bare root path.
        /^https:\/\/m365\.cloud\.microsoft\/\?(?:[^&]*&)*fromcode=[^&]+(?:&.*)?$/,
        /^https:\/\/copilot\.cloud\.microsoft\/chat\/.*[?&]titleId=[^&]+.*$/,
        /^https:\/\/copilot\.cloud\.microsoft\/apps\/.*[?&]titleId=[^&]+.*$/,
        /^https:\/\/copilot\.cloud\.microsoft\/apps\/.*[?&]appId=[^&]+.*$/,
        /^https:\/\/copilot\.cloud\.microsoft\/apps\/.*[?&]templatedAppId=[^&]+.*$/,
        /^https:\/\/copilot\.cloud\.microsoft\/chat\/entity1-d870f6cd-4aa5-4d42-9626-ab690c041429\/.*$/,
        /^https:\/\/copilot\.cloud\.microsoft\/create(?:\/.*)?(?:\?.*)?$/,
        /^https:\/\/copilot\.cloud\.microsoft\/cowork(?:\/.*)?(?:\?.*)?$/,
        /^https:\/\/copilot\.cloud\.microsoft\/chat\/try-voice-chat(?:\/.*)?(?:\?.*)?$/,
        /^https:\/\/copilot\.cloud\.microsoft\/chat(?:\/[^?]*)?\?(?:[^&]*&)*fromcode=[^&]+(?:&.*)?$/,
        /^https:\/\/copilot\.cloud\.microsoft\/\?(?:[^&]*&)*fromcode=[^&]+(?:&.*)?$/,
        /^https:\/\/copilot\.com\/chat\/.*[?&]titleId=[^&]+.*$/,
        /^https:\/\/copilot\.com\/apps\/.*[?&]titleId=[^&]+.*$/,
        /^https:\/\/copilot\.com\/apps\/.*[?&]appId=[^&]+.*$/,
        /^https:\/\/copilot\.com\/apps\/.*[?&]templatedAppId=[^&]+.*$/,
        /^https:\/\/copilot\.com\/chat\/entity1-d870f6cd-4aa5-4d42-9626-ab690c041429\/.*$/,
        /^https:\/\/copilot\.com\/create(?:\/.*)?(?:\?.*)?$/,
        /^https:\/\/copilot\.com\/chat\/try-voice-chat(?:\/.*)?(?:\?.*)?$/,
        /^https:\/\/copilot\.com\/chat(?:\/[^?]*)?\?(?:[^&]*&)*fromcode=[^&]+(?:&.*)?$/,
        /^https:\/\/copilot\.com\/\?(?:[^&]*&)*fromcode=[^&]+(?:&.*)?$/,
        /^https:\/\/www\.copilot\.com\/chat\/.*[?&]titleId=[^&]+.*$/,
        /^https:\/\/www\.copilot\.com\/apps\/.*[?&]titleId=[^&]+.*$/,
        /^https:\/\/www\.copilot\.com\/apps\/.*[?&]appId=[^&]+.*$/,
        /^https:\/\/www\.copilot\.com\/apps\/.*[?&]templatedAppId=[^&]+.*$/,
        /^https:\/\/www\.copilot\.com\/chat\/entity1-d870f6cd-4aa5-4d42-9626-ab690c041429\/.*$/,
        /^https:\/\/www\.copilot\.com\/create(?:\/.*)?(?:\?.*)?$/,
        /^https:\/\/www\.copilot\.com\/chat\/try-voice-chat(?:\/.*)?(?:\?.*)?$/,
        /^https:\/\/www\.copilot\.com\/chat(?:\/[^?]*)?\?(?:[^&]*&)*fromcode=[^&]+(?:&.*)?$/,
        /^https:\/\/www\.copilot\.com\/\?(?:[^&]*&)*fromcode=[^&]+(?:&.*)?$/,
        /^https:\/\/eus\.sdf\.www\.microsoft365\.com\/.*[?&]testsdfddls=true.*$/,
        /^https:\/\/test\.www\.officeppe\.com\/.*[?&]testppeddls=true.*$/
    ],

    // Store URLs
