[Unit]
Description=Hide the text boot menu on normal starts
ConditionPathExists=!/var/lib/oneclick/boot-menu-hidden

[Service]
Type=oneshot
ExecStart=/usr/bin/grub2-editenv - set menu_auto_hide=1
ExecStartPost=/usr/bin/mkdir -p /var/lib/oneclick
ExecStartPost=/usr/bin/touch /var/lib/oneclick/boot-menu-hidden

[Install]
WantedBy=multi-user.target
