#!/usr/bin/bash
# OneClick Update.
# 1. Checks quickly whether a newer system exists (only a small file is downloaded).
# 2. Offers "Download and restart" or "Download".
# 3. Downloads alongside the running system; nothing changes until restart.
# 4. "oneclick-update --rollback" goes back to the previous version.
set -u
TITLE="Update"
HELPER=/usr/libexec/oneclick-update-helper

busy() {  # busy "message" -> prints the progress window's handle
    local h; h=$(kdialog --title "$TITLE" --progressbar "$1" 0)
    qdbus-qt6 $h showCancelButton false >/dev/null 2>&1
    echo "$h"
}
done_busy() { qdbus-qt6 $1 close >/dev/null 2>&1; }

offer_restart() {
    if kdialog --title "$TITLE" --yesno "$1\n\nRestart now? Your open apps will close." \
        --yes-label "Restart now" --no-label "Later"; then
        systemctl reboot
    else
        kdialog --title "$TITLE" --passivepopup "The update will be used next time you restart." 6
    fi
}

failed() {
    kdialog --title "$TITLE" --error "$1\n\nCheck your internet connection and try again.\n\nDetails: $(tail -2 <<< "$2")"
}

if [[ "${1:-}" == "--rollback" ]]; then
    kdialog --title "$TITLE" --warningyesno "Go back to the version you had before the last update?\n\nYour files and apps are not affected." \
        --yes-label "Go back" --no-label "Cancel" || exit 0
    out=$(pkexec $HELPER rollback 2>&1) || { [[ $? -ge 126 ]] || failed "Could not go back to the previous version." "$out"; exit 1; }
    offer_restart "The previous version is ready."
    exit 0
fi

h=$(busy "Checking for updates...")
out=$(pkexec $HELPER check 2>&1); status=$?
done_busy "$h"
if (( status == 126 || status == 127 )); then exit 0; fi   # password prompt cancelled
if (( status != 0 )); then failed "Could not check for updates." "$out"; exit 1; fi

case "$(tail -1 <<< "$out")" in
    STAGED)
        offer_restart "An update has been downloaded and is ready." ;;
    NONE)
        if ! kdialog --title "$TITLE" --yesno "You're up to date." --yes-label "OK" --no-label "Go back to previous version..."; then
            exec "$0" --rollback
        fi ;;
    AVAILABLE)
        kdialog --title "$TITLE" --yesnocancel "A new version of OneClick OS is available.\n\nIt downloads in the background while you keep working." \
            --yes-label "Download and restart" --no-label "Download" --cancel-label "Not now"
        choice=$?
        (( choice == 2 )) && exit 0
        h=$(busy "Downloading the update... You can keep working.")
        out=$(pkexec $HELPER download 2>&1); status=$?
        done_busy "$h"
        if (( status == 126 || status == 127 )); then exit 0; fi
        if (( status != 0 )); then failed "The update could not be downloaded." "$out"; exit 1; fi
        if (( choice == 0 )); then
            systemctl reboot
        else
            offer_restart "The update is downloaded."
        fi ;;
esac
