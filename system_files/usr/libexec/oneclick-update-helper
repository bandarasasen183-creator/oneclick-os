#!/usr/bin/bash
# Runs as administrator for oneclick-update. Exit 0 = new version staged, 2 = already current.
set -o pipefail
before=$(bootc status --json | python3 -c 'import sys,json;d=json.load(sys.stdin)["status"];s=d.get("staged") or {};print((s.get("image") or {}).get("imageDigest",""))')
bootc upgrade --quiet || exit 1
after=$(bootc status --json | python3 -c 'import sys,json;d=json.load(sys.stdin)["status"];s=d.get("staged") or {};print((s.get("image") or {}).get("imageDigest",""))')
[[ -n "$after" ]] && exit 0
exit 2
